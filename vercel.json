{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "VITE_ELSEVIER_API_KEY": "${ELSEVIER_API_KEY}",
    "VITE_GROQ_API_KEY": "${GROQ_API_KEY}",
    "VITE_TAVILY_API_KEY": "${TAVILY_API_KEY}"
  }
}
